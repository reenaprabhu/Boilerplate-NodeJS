# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
USE_DATABASE=true
DB_PROVIDER=local

# Local SQL Server Configuration
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=1433
LOCAL_DB_NAME=myapp
LOCAL_DB_USER=sa
LOCAL_DB_PASSWORD=YourStrong@Passw0rd
LOCAL_DB_ENCRYPT=true
LOCAL_DB_TRUST_CERT=true

# Azure SQL Database Configuration (alternative)
AZURE_DB_HOST=your-server.database.windows.net
AZURE_DB_PORT=1433
AZURE_DB_NAME=your-database
AZURE_DB_USER=your-user@your-server
AZURE_DB_PASSWORD=your-password
AZURE_DB_ENCRYPT=true
AZURE_DB_TRUST_CERT=false

# Connection Pool Configuration
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT=30000
DB_LOGGING=false

# Database Initialization
DISABLE_DB_INIT=false

# Redis Configuration
REDIS_URL=redis://localhost:6379
USE_REDIS=true

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:4200
